# ONIRIA Investments backend - Windows local example
APP_NAME=ONIRIA Investments API
ENVIRONMENT=local
DEBUG=true
API_V1_PREFIX=/api/v1
FRONTEND_ORIGINS=http://localhost:3200,http://127.0.0.1:3200
# PostgreSQL installed directly on Windows.
# IMPORTANT: replace YOUR_URL_ENCODED_PASSWORD.
# If your password contains @, encode it as %40; the configure-local.ps1 script does this automatically.
DATABASE_URL=postgresql+asyncpg://postgres:YOUR_URL_ENCODED_PASSWORD@127.0.0.1:3310/oniria

# Supabase Auth / Storage - optional for public local pages, required for staff/admin features
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_JWT_ISSUER=https://your-project.supabase.co/auth/v1
SUPABASE_JWKS_URL=https://your-project.supabase.supabase.co/auth/v1/.well-known/jwks.json
SUPABASE_SECRET_KEY=your_supabase_secret_key_here
STORAGE_BUCKET=oniria-media

# Email / monitoring - optional locally
RESEND_API_KEY=
CONTACT_NOTIFICATION_EMAIL=oniriaassist@gmail.com
EMAIL_FROM=ONIRIA Investments <oniriaassist@gmail.com>
SENTRY_DSN=

# Public lead protection / uploads
LEAD_RATE_LIMIT_PER_MINUTE=10
MAX_UPLOAD_BYTES=10485760
ALLOWED_UPLOAD_MIME_TYPES=image/jpeg,image/png,image/webp,image/avif

