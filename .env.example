# FastAPI + PostgreSQL on Windows

APP_NAME=ONIRIA Investments API
ENVIRONMENT=local
DEBUG=true

API_V1_PREFIX=/api/v1

FRONTEND_ORIGINS=http://localhost:32000

# POSTGRESQL
# Port: 3310
DATABASE_URL=postgresql+asyncpg://postgres:Nassir@6243.@127.0.0.1:3310/oniria_investments

# SUPABASE AUTH / STORAGE
SUPABASE_URL=
SUPABASE_JWT_ISSUER=
SUPABASE_JWKS_URL=
SUPABASE_SERVICE_ROLE_KEY=
STORAGE_BUCKET=oniria-media

# EMAIL - RESEND
RESEND_API_KEY=
CONTACT_NOTIFICATION_EMAIL=oniriaassist@gmail.com
EMAIL_FROM=oniriaassist@gmail.com

# MONITORING
SENTRY_DSN=

# RATE LIMIT / UPLOAD SECURITY
LEAD_RATE_LIMIT_PER_MINUTE=10

MAX_UPLOAD_BYTES=10485760

ALLOWED_UPLOAD_MIME_TYPES=image/jpeg,image/png,image/webp,image/avif